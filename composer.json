{
	"name": "makr-holdings/steadhand",
	"description": "Secure AI agent access for WordPress: least-privilege MCP tools, guardrails and an audit trail.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^3.0"
	},
	"autoload": {
		"psr-4": {
			"Steadhand\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Steadhand\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"platform-check": false,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"test": [
			"Composer\\Config::disableProcessTimeout",
			"npx wp-env run tests-cli --env-cwd=wp-content/plugins/steadhand vendor/bin/phpunit"
		],
		"dev-updater:install": "composer install -d includes/Dev"
	}
}
