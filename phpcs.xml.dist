<?xml version="1.0"?>
<ruleset name="Steadhand">
	<description>WordPress Coding Standards (including its security sniffs) plus PHP 8.1+ compatibility.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/includes/Dev/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.9"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- PSR-4 autoloading: one class per file, file named after the class. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/includes/*</exclude-pattern>
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Test methods are named for the behavior they assert; a docblock on each one adds no information. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="steadhand"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="steadhand"/>
				<element value="Steadhand"/>
			</property>
		</properties>
	</rule>
</ruleset>
